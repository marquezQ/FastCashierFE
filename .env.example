# ============================================================
# FastCashierFE — Variables de Entorno
# ============================================================
# Copia este archivo como .env y ajusta los valores.
# El archivo .env NUNCA se sube al repositorio (.gitignore).
# ============================================================

# ------------------------------------------------------------
# API
# URL base del backend. Sin barra final.
# ------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api

# ------------------------------------------------------------
# Modo de la aplicación
#   demo        → muestra accesos rápidos en el login (hardcodeados)
#   production  → login limpio, sin accesos rápidos (cliente real)
#
# DEFAULT: si la variable no está definida se asume "production".
# ------------------------------------------------------------
VITE_APP_MODE=demo

# ------------------------------------------------------------
# Nombre del negocio
# Se muestra en la pantalla de login y en el footer.
# ------------------------------------------------------------
VITE_BUSINESS_NAME=FastCashier
